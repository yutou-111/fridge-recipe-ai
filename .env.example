# 复制本文件并命名为 .env，填写等号右边的内容，保存后重启 node server.js。
# 从你使用的 AI 平台或中转站复制完整的 Chat Completions 接口地址、Key 和模型名。

# 完整接口地址（通常以 /chat/completions 结尾）
AI_API_URL=https://api.deepseek.com/chat/completions

# 填写你自己的 API Key
AI_API_KEY=

# 填写平台提供的文字模型名
AI_CHAT_MODEL=deepseek-flash

# 填写支持图片的模型名；留空则使用上面的文字模型
AI_VISION_MODEL=

# 保持 auto 即可
AI_THINKING=auto

# 真实 .env 不要上传 GitHub。
